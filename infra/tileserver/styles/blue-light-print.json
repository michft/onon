{
  "version": 8,
  "name": "Onon Blue-Light Print",
  "metadata": { "onon:profile": "blue-light-print", "openmaptiles:version": "3.x" },
  "center": [151.17, -33.87],
  "zoom": 11,
  "sources": { "openmaptiles": { "type": "vector", "url": "mbtiles://{sydney}", "attribution": "© OpenMapTiles © OpenStreetMap contributors" } },
  "glyphs": "{fontstack}/{range}.pbf",
  "layers": [
    { "id": "background", "type": "background", "paint": { "background-color": "#fffdf5" } },
    { "id": "landcover", "type": "fill", "source": "openmaptiles", "source-layer": "landcover", "paint": { "fill-color": "#e8dfc4", "fill-opacity": 0.7 } },
    { "id": "park", "type": "fill", "source": "openmaptiles", "source-layer": "park", "paint": { "fill-color": "#d5c39d", "fill-outline-color": "#695b3f" } },
    { "id": "water", "type": "fill", "source": "openmaptiles", "source-layer": "water", "paint": { "fill-color": "#b8aca0", "fill-outline-color": "#493f36" } },
    { "id": "waterway", "type": "line", "source": "openmaptiles", "source-layer": "waterway", "paint": { "line-color": "#493f36", "line-width": 1.8, "line-dasharray": [1, 1.5] } },
    { "id": "buildings", "type": "fill", "source": "openmaptiles", "source-layer": "building", "minzoom": 13, "paint": { "fill-color": "#eee9df", "fill-outline-color": "#5f574e" } },
    { "id": "roads", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "filter": ["==", "$type", "LineString"], "paint": { "line-color": "#5b5045", "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.7, 16, 5.2] } },
    { "id": "boundaries", "type": "line", "source": "openmaptiles", "source-layer": "boundary", "paint": { "line-color": "#5f3027", "line-width": 1.5, "line-dasharray": [5, 2] } },
    { "id": "road-labels", "type": "symbol", "source": "openmaptiles", "source-layer": "transportation_name", "minzoom": 12, "filter": ["==", "$type", "LineString"], "layout": { "symbol-placement": "line", "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]], "text-font": ["Open Sans Regular"], "text-size": ["interpolate", ["linear"], ["zoom"], 12, 10, 16, 13] }, "paint": { "text-color": "#17130f", "text-halo-color": "#fffdf5", "text-halo-width": 1.5 } },
    { "id": "place-labels", "type": "symbol", "source": "openmaptiles", "source-layer": "place", "layout": { "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]], "text-font": ["Open Sans Semibold"], "text-size": 12 }, "paint": { "text-color": "#17130f", "text-halo-color": "#fffdf5", "text-halo-width": 1.5 } }
  ]
}
