{
  "version": 8,
  "name": "Onon Screen",
  "metadata": { "onon:profile": "screen", "openmaptiles:version": "3.x" },
  "center": [151.17, -33.87],
  "zoom": 11,
  "sources": { "openmaptiles": { "type": "vector", "url": "mbtiles://{sydney}", "attribution": "© OpenMapTiles © OpenStreetMap contributors" } },
  "glyphs": "{fontstack}/{range}.pbf",
  "layers": [
    { "id": "background", "type": "background", "paint": { "background-color": "#f7f3e8" } },
    { "id": "landcover", "type": "fill", "source": "openmaptiles", "source-layer": "landcover", "paint": { "fill-color": "#dce8cf", "fill-opacity": 0.65 } },
    { "id": "park", "type": "fill", "source": "openmaptiles", "source-layer": "park", "paint": { "fill-color": "#b9d8ae", "fill-outline-color": "#779b70" } },
    { "id": "water", "type": "fill", "source": "openmaptiles", "source-layer": "water", "paint": { "fill-color": "#8bc4d8" } },
    { "id": "waterway", "type": "line", "source": "openmaptiles", "source-layer": "waterway", "paint": { "line-color": "#5b9db8", "line-width": 1.4 } },
    { "id": "buildings", "type": "fill", "source": "openmaptiles", "source-layer": "building", "minzoom": 13, "paint": { "fill-color": "#d8cec1", "fill-outline-color": "#a79b8b" } },
    { "id": "roads", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "filter": ["==", "$type", "LineString"], "paint": { "line-color": "#806f5f", "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.7, 16, 5] } },
    { "id": "boundaries", "type": "line", "source": "openmaptiles", "source-layer": "boundary", "paint": { "line-color": "#8e6d91", "line-width": 1.2, "line-dasharray": [4, 2] } },
    { "id": "road-labels", "type": "symbol", "source": "openmaptiles", "source-layer": "transportation_name", "minzoom": 12, "filter": ["==", "$type", "LineString"], "layout": { "symbol-placement": "line", "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]], "text-font": ["Open Sans Regular"], "text-size": ["interpolate", ["linear"], ["zoom"], 12, 10, 16, 13] }, "paint": { "text-color": "#302b27", "text-halo-color": "#ffffff", "text-halo-width": 1.2 } },
    { "id": "place-labels", "type": "symbol", "source": "openmaptiles", "source-layer": "place", "layout": { "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]], "text-font": ["Open Sans Regular"], "text-size": 12 }, "paint": { "text-color": "#302b27", "text-halo-color": "#ffffff", "text-halo-width": 1.2 } }
  ]
}
