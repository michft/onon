# Copy is created automatically as local.env by scripts/bootstrap-local.sh.
POSTGRES_USER=onon
POSTGRES_DB=onon
POSTGRES_PASSWORD=generated-by-bootstrap
ONON_POSTGRES_VOLUME=onon-postgres-data
ONON_POSTGRES_VOLUME_SIZE=20G
ADMIN_TOKEN=generated-admin-token

ONON_NETWORK=onon-private
ONON_BIND_ADDRESS=0.0.0.0
ONON_TILESERVER_PORT=8080
ONON_TILESERVER_MEMORY=2G
ONON_WEB_PORT=3000
ONON_TILESERVER_ALLOWED_HOSTS=localhost,127.0.0.1
ONON_PUBLIC_HOST=generated-local-host
# Address embedded in iPhone pairing QR and native map URLs. Bootstrap chooses
# the Mac's LAN IPv4 when available; override if the Mac has multiple networks.
ONON_PAIRING_HOST=generated-lan-ip

# Reuse downloaded OSM inputs and checked OCI images until this many days old.
# Set to 0 only when intentionally forcing a remote refresh.
ONON_REMOTE_DOWNLOAD_MAX_AGE_DAYS=7

# Built locally by scripts/build-app-image.sh.
ONON_WEB_IMAGE=onon-app:local

# Planetiler input and Sydney tile-generation envelope (west,south,east,north).
ONON_OSM_PBF_URL=https://download.geofabrik.de/australia-oceania/australia-latest.osm.pbf
ONON_SERVICE_BOUNDS=151.00,-34.04,151.33,-33.70
ONON_PLANETILER_MEMORY=8G
ONON_PLANETILER_CONTAINER_MEMORY=10G
ONON_PLANETILER_CPUS=4
ONON_MAP_SMOKE_PORT=18081
